# ─────────────────────────────────────────────────────────────────────────────
# Gate — environment variables
#
# Local:      cp .env.example .env  then fill in the required values
# Codespaces: the post-create script does this automatically
#
# Values marked  ← required   must be set before running the app
# Values marked  ← optional   enable specific features (calendar, email)
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# In Codespaces replace with your forwarded URL:
#   https://<codespace-name>-3000.app.github.dev
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database ──────────────────────────────────────────────────────────────────
# Codespaces: automatically set to the docker-compose Postgres service.
# Local:      make sure PostgreSQL is running on port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gatekeeper"

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
# Generate:  openssl rand -base64 32
# Codespaces: the post-create script auto-generates this.
NEXTAUTH_SECRET="change-me"                          # ← required
AUTH_SECRET="change-me"                              # ← required (same value)
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (calendar integration) ──────────────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 client ID (Web application)
# 3. Add these Authorised redirect URIs:
#      http://localhost:3000/api/app/google/callback        (local)
#      https://<codespace>-3000.app.github.dev/api/app/google/callback  (Codespaces)
GOOGLE_CLIENT_ID=""                                  # ← optional
GOOGLE_CLIENT_SECRET=""                              # ← optional
GOOGLE_REDIRECT_URI="http://localhost:3000/api/app/google/callback"

# ── Email notifications (Resend) ──────────────────────────────────────────────
# Sign up free at resend.com — 3 000 emails/month on the free tier.
# Without this, booking emails are queued but not sent.
RESEND_API_KEY=""                                    # ← optional
EMAIL_FROM="Gate <noreply@example.com>"

# ── AI semantic qualification (OpenAI) ────────────────────────────────────────
# Required for the AI gate to route visitors against the expert's ideal-persona
# description.  Get a key at platform.openai.com.
# Without this, the gate auto-qualifies every visitor (calendar opens for all).
OPENAI_API_KEY=""                                    # ← optional

# ── Cryptography ─────────────────────────────────────────────────────────────
# Used to encrypt stored OAuth tokens at rest (lib/crypto.ts). Falls back to
# AUTH_SECRET, then NEXTAUTH_SECRET, if unset — set this explicitly rather
# than relying on that fallback, since it means encryption reuses a secret
# that's also doing session-signing duty.
# Generate:  openssl rand -hex 32
ENCRYPTION_SECRET=""                                 # ← recommended

# Pepper for access code hashing (protects hashes if the DB is dumped).
# Generate:  openssl rand -hex 32
ACCESS_CODE_PEPPER=""                                # ← optional

# ── Google OAuth (booking auth — separate from calendar OAuth above) ──────────
AUTH_GOOGLE_ID=""                                    # ← optional
AUTH_GOOGLE_SECRET=""                                # ← optional

# ── Sentry error tracking ─────────────────────────────────────────────────────
# Sign up free at sentry.io.  Leave blank — Sentry is a no-op without a DSN.
NEXT_PUBLIC_SENTRY_DSN=""                            # ← optional (browser)
SENTRY_DSN=""                                        # ← optional (server)
SENTRY_ORG=""                                        # ← optional (build-time)
SENTRY_PROJECT=""                                    # ← optional (build-time)
# Personal auth token for source-map uploads during CI builds
SENTRY_AUTH_TOKEN=""                                 # ← optional (CI only)