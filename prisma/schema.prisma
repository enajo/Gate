generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum LeadQualificationResult {
  QUALIFIED
  REJECTED
  REDIRECTED
  PENDING_REVIEW
}

enum LeadOutcome {
  WON
  LOST
  NO_RESPONSE
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityExposure {
  THREE_DAYS
  FIVE_DAYS
  ONE_WEEK
  TWO_WEEKS
  ONE_MONTH
  TWO_MONTHS
  ALL
}

enum BookingEventType {
  HOLD_CREATED
  HOLD_EXPIRED
  HOLD_CONVERTED
  BOOKING_CONFIRMED
  PAYMENT_AUTHORIZED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  CALENDAR_EVENT_CREATED
  CALENDAR_EVENT_FAILED
  EMAIL_SENT
  EMAIL_FAILED
  ACCESS_CODE_VALIDATED
  ACCESS_CODE_ROTATED
  MANUALLY_APPROVED
  MANUALLY_REJECTED
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum CalendarSyncStatus {
  PENDING
  CONNECTED
  SYNCING
  ERROR
  EXPIRED
  DISCONNECTED
}

enum BookingHoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

enum BookingStatus {
  PENDING_CODE
  CODE_INVALID
  CONFIRMED
  EVENT_CREATION_PENDING
  EVENT_CREATED
  CANCELLED
}

enum CodeValidationStatus {
  PENDING
  VALID
  INVALID
}

enum CalendarStatus {
  PENDING
  CREATED
  FAILED
}

enum CalendarEventSyncStatus {
  PENDING
  CREATED
  UPDATED
  FAILED
  CANCELLED
}

enum NotificationRecipientType {
  CLIENT
  PROFESSIONAL
}

enum NotificationType {
  BOOKING_CONFIRMED
  EVENT_CREATED
  EVENT_CREATION_FAILED
  BOOKING_CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?    @map("email_verified")
  image         String?
  role          UserRole     @default(USER)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  professional  Professional?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @db.Text @map("refresh_token")
  accessToken       String? @db.Text @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @db.Text @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Professional {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  fullName              String    @map("full_name")
  slug                  String    @unique
  title                 String?
  headline              String?
  bio                   String?   @db.Text
  avatarUrl             String?   @map("avatar_url")
  brandSettings         Json?     @map("brand_settings")
  socialLinks           Json?     @map("social_links")
  timezone              String    @default("UTC")
  onboardingCompleted   Boolean   @default(false) @map("onboarding_completed")
  publishedAt           DateTime? @map("published_at")
  publicPageSettings    Json?     @map("public_page_settings")
  draftSettings         Json?     @map("draft_settings")
  bufferBeforeMinutes        Int       @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes         Int       @default(0) @map("buffer_after_minutes")
  minimumNoticeMinutes       Int       @default(0) @map("minimum_notice_minutes")
  maxBookingsPerDay          Int?      @map("max_bookings_per_day")
  /** Calendly-style "how will you use this / what do you need" onboarding answers — { usageMode, goals }. Signal, not config. */
  onboardingSurvey            Json?     @map("onboarding_survey")
  planTier                   PlanTier  @default(FREE) @map("plan_tier")
  tokenBalance               Int       @default(15000) @map("token_balance")
  tokenBalanceResetAt        DateTime? @map("token_balance_reset_at")
  industry                   String?   @map("industry")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               Service[]
  testimonials           Testimonial[]
  availabilityRules      AvailabilityRule[]
  blockedDates           BlockedDate[]
  calendarAccounts       CalendarAccount[]
  accessCodes            AccessCode[]
  leads                  Lead[]
  bookingHolds           BookingHold[]
  bookings               Booking[]
  visits                 Visit[]

  @@map("professionals")
}

model Service {
  id                      String    @id @default(cuid())
  professionalId          String    @map("professional_id")
  title                   String
  slug                    String?
  headline                String?   @db.Text
  description             String?   @db.Text
  meetingFormat           String?   @default("Video call") @map("meeting_format")
  displayPrice            String?   @map("display_price")
  currency                String?   @default("$")
  durationMinutes         Int       @map("duration_minutes")
  preparationInstructions String?   @db.Text @map("preparation_instructions")
  directPurchaseUrl       String?   @map("direct_purchase_url")
  idealPersonaDescription String?   @db.Text @map("ideal_persona_description")
  gateSetupAnswers        Json?     @map("gate_setup_answers")
  paymentRequired         Boolean   @default(false) @map("payment_required")
  qualificationRequired   Boolean   @default(false) @map("qualification_required")
  accessCodeRequired      Boolean   @default(false) @map("access_code_required")
  manualApprovalRequired  Boolean   @default(false) @map("manual_approval_required")
  availabilityExposure    AvailabilityExposure @default(TWO_WEEKS) @map("availability_exposure")
  sortOrder               Int       @default(0) @map("sort_order")
  active                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  professional           Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  accessCodes            AccessCode[]
  leads                  Lead[]
  bookingHolds           BookingHold[]
  bookings               Booking[]

  @@unique([professionalId, slug])
  @@index([professionalId, active])
  @@map("services")
}

model Testimonial {
  id             String   @id @default(cuid())
  professionalId String   @map("professional_id")
  name           String
  role           String?
  company        String?
  content        String   @db.Text
  rating         Int?
  avatarUrl      String?  @map("avatar_url")
  approved       Boolean  @default(true)
  featured       Boolean  @default(false)
  hidden         Boolean  @default(false)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, sortOrder])
  @@map("testimonials")
}


model AvailabilityRule {
  id             String    @id @default(cuid())
  professionalId String    @map("professional_id")
  weekday        Weekday
  startTime      String    @map("start_time")
  endTime        String    @map("end_time")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday, active])
  @@map("availability_rules")
}

model BlockedDate {
  id             String    @id @default(cuid())
  professionalId String    @map("professional_id")
  startDateTime  DateTime  @map("start_datetime")
  endDateTime    DateTime  @map("end_datetime")
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startDateTime, endDateTime])
  @@map("blocked_dates")
}

model CalendarAccount {
  id                     String             @id @default(cuid())
  professionalId         String             @map("professional_id")
  provider               CalendarProvider
  externalAccountId      String             @map("external_account_id")
  externalCalendarId     String?            @map("external_calendar_id")
  providerEmail          String?            @map("provider_email")
  calendarName           String?            @map("calendar_name")
  calendarTimeZone       String?            @map("calendar_time_zone")
  accessTokenEncrypted   String             @db.Text @map("access_token_encrypted")
  refreshTokenEncrypted  String?            @db.Text @map("refresh_token_encrypted")
  syncStatus             CalendarSyncStatus @default(PENDING) @map("sync_status")
  isActive               Boolean            @default(true) @map("is_active")
  useForConflictCheck    Boolean            @default(true) @map("use_for_conflict_check")
  isDefaultEventCalendar Boolean            @default(false) @map("is_default_event_calendar")
  lastSyncedAt           DateTime?          @map("last_synced_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  professional  Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]

  @@unique([provider, externalAccountId, externalCalendarId])
  @@index([professionalId, isActive])
  @@index([professionalId, useForConflictCheck])
  @@index([professionalId, isDefaultEventCalendar])
  @@map("calendar_accounts")
}

model AccessCode {
  id             String    @id @default(cuid())
  professionalId String    @map("professional_id")
  codeHash       String    @map("code_hash")
  codeLabel      String?   @map("code_label")
  isActive       Boolean   @default(true) @map("is_active")
  usedAt         DateTime? @map("used_at")
  usedByEmail    String?   @map("used_by_email")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  serviceId      String?   @map("service_id")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([professionalId, isActive])
  @@index([serviceId, isActive])
  @@map("access_codes")
}

model Lead {
  id                  String                  @id @default(cuid())
  professionalId      String                  @map("professional_id")
  serviceId           String                  @map("service_id")
  name                String
  email               String
  answersJson         Json                    @map("answers_json")
  qualificationResult LeadQualificationResult @map("qualification_result")
  /** Referrer header captured on the visitor's first hit to the public page (e.g. "https://chatgpt.com/"). */
  referrer            String?
  utmSource           String?                 @map("utm_source")
  utmMedium           String?                 @map("utm_medium")
  utmCampaign         String?                 @map("utm_campaign")
  /** Professional's correction of the AI's decision, if they've reviewed it. Null means never reviewed. */
  correctedResult     LeadQualificationResult? @map("corrected_result")
  correctionNote      String?                 @map("correction_note")
  correctedAt         DateTime?               @map("corrected_at")
  /** Real-world outcome, collected via a one-click follow-up email — the verifiability signal behind outcome pricing. */
  outcome              LeadOutcome? @map("outcome")
  outcomeValue         Int?         @map("outcome_value")
  outcomeToken         String?      @unique @map("outcome_token")
  outcomeRespondedAt   DateTime?    @map("outcome_responded_at")
  outcomeFollowUpSentAt DateTime?   @map("outcome_follow_up_sent_at")
  /** AI-generated pre-call prep, cached from the qualification transcript — regenerated only if never run. */
  briefingSummary      Json?        @map("briefing_summary")
  briefingGeneratedAt  DateTime?    @map("briefing_generated_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingHolds BookingHold[]
  bookings     Booking[]
  visits       Visit[]

  @@index([professionalId, createdAt])
  @@index([serviceId, createdAt])
  @@map("leads")
}

/** One anonymous hit on a professional's public page, before (or without) ever becoming a Lead. */
model Visit {
  id             String   @id @default(cuid())
  professionalId String   @map("professional_id")
  visitorId      String   @map("visitor_id")
  leadId         String?  @map("lead_id")
  referrer       String?
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  landingPath    String?  @map("landing_path")
  createdAt      DateTime @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([professionalId, visitorId])
  @@index([leadId])
  @@map("visits")
}

model BookingHold {
  id             String            @id @default(cuid())
  professionalId String            @map("professional_id")
  serviceId      String            @map("service_id")
  leadId         String?           @map("lead_id")
  slotStart      DateTime          @map("slot_start")
  slotEnd        DateTime          @map("slot_end")
  expiresAt      DateTime          @map("expires_at")
  status         BookingHoldStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking      Booking?

  @@index([professionalId, slotStart, slotEnd])
  @@index([expiresAt, status])
  @@map("booking_holds")
}

model Booking {
  id                   String               @id @default(cuid())
  professionalId       String               @map("professional_id")
  serviceId            String               @map("service_id")
  leadId               String               @map("lead_id")
  holdId               String               @unique @map("hold_id")
  slotStart            DateTime             @map("slot_start")
  slotEnd              DateTime             @map("slot_end")
  timezone             String
  status               BookingStatus        @default(PENDING_CODE)
  codeValidationStatus CodeValidationStatus @default(PENDING) @map("code_validation_status")
  calendarStatus       CalendarStatus       @default(PENDING) @map("calendar_status")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  professional  Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  hold          BookingHold    @relation(fields: [holdId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]
  notifications  Notification[]
  bookingEvents  BookingEvent[]

  @@index([professionalId, slotStart, slotEnd])
  @@index([status, calendarStatus])
  @@index([leadId])
  @@map("bookings")
}

model CalendarEvent {
  id              String                  @id @default(cuid())
  bookingId       String                  @map("booking_id")
  calendarAccountId String                @map("calendar_account_id")
  externalEventId String                  @map("external_event_id")
  eventUrl        String?                 @map("event_url")
  meetingUrl      String?                 @map("meeting_url")
  syncStatus      CalendarEventSyncStatus @default(PENDING) @map("sync_status")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  calendarAccount CalendarAccount @relation(fields: [calendarAccountId], references: [id], onDelete: Cascade)

  @@unique([calendarAccountId, externalEventId])
  @@index([bookingId])
  @@map("calendar_events")
}

model BookingEvent {
  id        String           @id @default(cuid())
  bookingId String           @map("booking_id")
  type      BookingEventType
  payload   Json?
  createdAt DateTime         @default(now()) @map("created_at")

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Notification {
  id             String                     @id @default(cuid())
  bookingId      String                     @map("booking_id")
  recipientType  NotificationRecipientType  @map("recipient_type")
  recipientEmail String                     @map("recipient_email")
  type           NotificationType
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  providerMessageId String?                 @map("provider_message_id")
  errorMessage   String?                    @db.Text @map("error_message")
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, deliveryStatus])
  @@index([recipientEmail])
  @@map("notifications")
}