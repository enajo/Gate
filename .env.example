# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expert_gatekeeper?schema=public"

# Auth
AUTH_SECRET=replace_me_with_a_long_random_string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/app/google/callback

# Email
RESEND_API_KEY=
EMAIL_FROM="Expert Gatekeeper <noreply@example.com>"

# Optional encryption / hashing helpers
ENCRYPTION_KEY=replace_me_with_32_characters_minimum
ACCESS_CODE_PEPPER=replace_me