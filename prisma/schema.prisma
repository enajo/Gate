generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  MULTIPLE_CHOICE
  YES_NO
}

enum QualificationOutcomeType {
  ALLOW_BOOKING
  REJECT
  REDIRECT
}

enum LeadQualificationResult {
  QUALIFIED
  REJECTED
  REDIRECTED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum CalendarSyncStatus {
  PENDING
  CONNECTED
  SYNCING
  ERROR
  EXPIRED
  DISCONNECTED
}

enum BookingHoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

enum BookingStatus {
  PENDING_CODE
  CODE_INVALID
  CONFIRMED
  EVENT_CREATION_PENDING
  EVENT_CREATED
  CANCELLED
}

enum CodeValidationStatus {
  PENDING
  VALID
  INVALID
}

enum CalendarStatus {
  PENDING
  CREATED
  FAILED
}

enum CalendarEventSyncStatus {
  PENDING
  CREATED
  UPDATED
  FAILED
  CANCELLED
}

enum NotificationRecipientType {
  CLIENT
  PROFESSIONAL
}

enum NotificationType {
  BOOKING_CONFIRMED
  EVENT_CREATED
  EVENT_CREATION_FAILED
  BOOKING_CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?    @map("email_verified")
  image         String?
  role          UserRole     @default(USER)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  professional  Professional?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @db.Text @map("refresh_token")
  accessToken       String? @db.Text @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @db.Text @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Professional {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  fullName              String    @map("full_name")
  slug                  String    @unique
  title                 String?
  headline              String?
  bio                   String?   @db.Text
  avatarUrl             String?   @map("avatar_url")
  brandSettings         Json?     @map("brand_settings")
  socialLinks           Json?     @map("social_links")
  timezone              String    @default("UTC")
  onboardingCompleted   Boolean   @default(false) @map("onboarding_completed")
  bufferBeforeMinutes   Int       @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes    Int       @default(0) @map("buffer_after_minutes")
  minimumNoticeMinutes  Int       @default(0) @map("minimum_notice_minutes")
  maxBookingsPerDay     Int?      @map("max_bookings_per_day")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               Service[]
  testimonials           Testimonial[]
  qualificationQuestions QualificationQuestion[]
  qualificationRules     QualificationRule[]
  availabilityRules      AvailabilityRule[]
  blockedDates           BlockedDate[]
  calendarAccounts       CalendarAccount[]
  accessCodes            AccessCode[]
  leads                  Lead[]
  bookingHolds           BookingHold[]
  bookings               Booking[]

  @@map("professionals")
}

model Service {
  id                      String    @id @default(cuid())
  professionalId          String    @map("professional_id")
  title                   String
  slug                    String?
  description             String?   @db.Text
  displayPrice            String?   @map("display_price")
  durationMinutes         Int       @map("duration_minutes")
  preparationInstructions String?   @db.Text @map("preparation_instructions")
  active                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  professional           Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  qualificationQuestions QualificationQuestion[]
  qualificationRules     QualificationRule[]
  leads                  Lead[]
  bookingHolds           BookingHold[]
  bookings               Booking[]

  @@unique([professionalId, slug])
  @@index([professionalId, active])
  @@map("services")
}

model Testimonial {
  id             String   @id @default(cuid())
  professionalId String   @map("professional_id")
  name           String
  role           String?
  company        String?
  content        String   @db.Text
  avatarUrl      String?  @map("avatar_url")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, sortOrder])
  @@map("testimonials")
}

model QualificationQuestion {
  id             String       @id @default(cuid())
  professionalId String       @map("professional_id")
  serviceId      String?      @map("service_id")
  questionText   String       @map("question_text")
  questionType   QuestionType @map("question_type")
  optionsJson    Json?        @map("options_json")
  helpText       String?      @db.Text @map("help_text")
  sortOrder      Int          @default(0) @map("sort_order")
  isRequired     Boolean      @default(true) @map("is_required")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([professionalId, sortOrder])
  @@index([serviceId, sortOrder])
  @@map("qualification_questions")
}

model QualificationRule {
  id             String                   @id @default(cuid())
  professionalId String                   @map("professional_id")
  serviceId      String?                  @map("service_id")
  conditionsJson Json                     @map("conditions_json")
  outcomeType    QualificationOutcomeType @map("outcome_type")
  outcomeValue   String?                  @db.Text @map("outcome_value")
  priority       Int                      @default(0)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([professionalId, priority])
  @@index([serviceId, priority])
  @@map("qualification_rules")
}

model AvailabilityRule {
  id             String    @id @default(cuid())
  professionalId String    @map("professional_id")
  weekday        Weekday
  startTime      String    @map("start_time")
  endTime        String    @map("end_time")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday, active])
  @@map("availability_rules")
}

model BlockedDate {
  id             String    @id @default(cuid())
  professionalId String    @map("professional_id")
  startDateTime  DateTime  @map("start_datetime")
  endDateTime    DateTime  @map("end_datetime")
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startDateTime, endDateTime])
  @@map("blocked_dates")
}

model CalendarAccount {
  id                     String             @id @default(cuid())
  professionalId         String             @map("professional_id")
  provider               CalendarProvider
  externalAccountId      String             @map("external_account_id")
  externalCalendarId     String?            @map("external_calendar_id")
  providerEmail          String?            @map("provider_email")
  calendarName           String?            @map("calendar_name")
  calendarTimeZone       String?            @map("calendar_time_zone")
  accessTokenEncrypted   String             @db.Text @map("access_token_encrypted")
  refreshTokenEncrypted  String?            @db.Text @map("refresh_token_encrypted")
  syncStatus             CalendarSyncStatus @default(PENDING) @map("sync_status")
  isActive               Boolean            @default(true) @map("is_active")
  useForConflictCheck    Boolean            @default(true) @map("use_for_conflict_check")
  isDefaultEventCalendar Boolean            @default(false) @map("is_default_event_calendar")
  lastSyncedAt           DateTime?          @map("last_synced_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  professional  Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]

  @@unique([provider, externalAccountId, externalCalendarId])
  @@index([professionalId, isActive])
  @@index([professionalId, useForConflictCheck])
  @@index([professionalId, isDefaultEventCalendar])
  @@map("calendar_accounts")
}

model AccessCode {
  id             String   @id @default(cuid())
  professionalId String   @map("professional_id")
  codeHash       String   @map("code_hash")
  codeLabel      String?  @map("code_label")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, isActive])
  @@map("access_codes")
}

model Lead {
  id                  String                  @id @default(cuid())
  professionalId      String                  @map("professional_id")
  serviceId           String                  @map("service_id")
  name                String
  email               String
  answersJson         Json                    @map("answers_json")
  qualificationResult LeadQualificationResult @map("qualification_result")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingHolds BookingHold[]
  bookings     Booking[]

  @@index([professionalId, createdAt])
  @@index([serviceId, createdAt])
  @@map("leads")
}

model BookingHold {
  id             String            @id @default(cuid())
  professionalId String            @map("professional_id")
  serviceId      String            @map("service_id")
  leadId         String?           @map("lead_id")
  slotStart      DateTime          @map("slot_start")
  slotEnd        DateTime          @map("slot_end")
  expiresAt      DateTime          @map("expires_at")
  status         BookingHoldStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking      Booking?

  @@index([professionalId, slotStart, slotEnd])
  @@index([expiresAt, status])
  @@map("booking_holds")
}

model Booking {
  id                   String               @id @default(cuid())
  professionalId       String               @map("professional_id")
  serviceId            String               @map("service_id")
  leadId               String               @map("lead_id")
  holdId               String               @unique @map("hold_id")
  slotStart            DateTime             @map("slot_start")
  slotEnd              DateTime             @map("slot_end")
  timezone             String
  status               BookingStatus        @default(PENDING_CODE)
  codeValidationStatus CodeValidationStatus @default(PENDING) @map("code_validation_status")
  calendarStatus       CalendarStatus       @default(PENDING) @map("calendar_status")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  professional  Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  hold          BookingHold    @relation(fields: [holdId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]
  notifications Notification[]

  @@index([professionalId, slotStart, slotEnd])
  @@index([status, calendarStatus])
  @@index([leadId])
  @@map("bookings")
}

model CalendarEvent {
  id              String                  @id @default(cuid())
  bookingId       String                  @map("booking_id")
  calendarAccountId String                @map("calendar_account_id")
  externalEventId String                  @map("external_event_id")
  eventUrl        String?                 @map("event_url")
  meetingUrl      String?                 @map("meeting_url")
  syncStatus      CalendarEventSyncStatus @default(PENDING) @map("sync_status")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  calendarAccount CalendarAccount @relation(fields: [calendarAccountId], references: [id], onDelete: Cascade)

  @@unique([calendarAccountId, externalEventId])
  @@index([bookingId])
  @@map("calendar_events")
}

model Notification {
  id             String                     @id @default(cuid())
  bookingId      String                     @map("booking_id")
  recipientType  NotificationRecipientType  @map("recipient_type")
  recipientEmail String                     @map("recipient_email")
  type           NotificationType
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  providerMessageId String?                 @map("provider_message_id")
  errorMessage   String?                    @db.Text @map("error_message")
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, deliveryStatus])
  @@index([recipientEmail])
  @@map("notifications")
}